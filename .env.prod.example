# Copy to .env.prod next to docker-compose.prod.yml on the VPS. Never commit .env.prod.
# DATABASE_URL, PORT, NODE_ENV and BETTER_AUTH_URL are set by docker-compose.prod.yml; do not repeat them here.

DOMAIN=suky-api.the1struleoffightclub.top

# Postgres container + API connection (DATABASE_URL is built from these).
# POSTGRES_PASSWORD must be URL-safe (it goes into a postgresql:// URL): use `openssl rand -hex 24`, never @ : / # %.
POSTGRES_USER=suky
POSTGRES_PASSWORD=
POSTGRES_DB=suky

# Email of the admin row created by `make seed` (defaults to admin@suky.vn). The seed sets NO password, see the deploy guide.
ADMIN_EMAIL=

# Required in production: API refuses to start with the dev secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin(s) of the web app calling this API, comma separated (e.g. http://localhost:5173,https://app.example.com)
CORS_ORIGIN=

# Required in production, all three together
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (optional: missing keys never block startup, the AI features just fail)
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
