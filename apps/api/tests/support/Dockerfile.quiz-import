FROM oven/bun:1.4.4-slim
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-writer fonts-dejavu-core ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN printf '%s' '{"type":"module","dependencies":{"mammoth":"1.13.0","unpdf":"1.8.1","fflate":"0.8.3","zod":"3.25.76"}}' > package.json && bun install && mkdir -p node_modules/@repo && ln -s /app/packages/shared node_modules/@repo/shared
COPY packages/shared /app/packages/shared
COPY apps/api/src /app/apps/api/src
COPY apps/api/tests /app/apps/api/tests
ENV QUIZ_IMPORT_OFFICE_PATH=/usr/bin/libreoffice
WORKDIR /app/apps/api
CMD ["bun", "test", "tests/quiz-import-reader.test.ts", "tests/quiz-import-runner.test.ts"]
