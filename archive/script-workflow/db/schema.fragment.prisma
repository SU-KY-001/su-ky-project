enum AudioProvider {
  UPLOAD
  ELEVENLABS

  @@map("audio_provider")
}

model WorkflowRun {
  id          Int       @id @default(autoincrement())
  seriesId    String?   @map("series_id") @db.Uuid
  topic       String    @db.Text
  focusHint   String?   @map("focus_hint") @db.Text
  status      String    @default("PENDING") @db.VarChar(32)
  currentStep String?   @map("current_step") @db.VarChar(64)
  createdById String    @map("created_by_id") @db.VarChar(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  series      Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  steps       WorkflowStep[]
  events      WorkflowEvent[]
  publications ScriptPublication[]

  @@index([createdById, createdAt], map: "workflow_runs_created_by_id_created_at_idx")
  @@index([seriesId], map: "workflow_runs_series_id_idx")
  @@map("workflow_runs")
}

model WorkflowStep {
  id               Int         @id @default(autoincrement())
  workflowRunId    Int         @map("workflow_run_id")
  stepType         String      @map("step_type") @db.VarChar(64)
  status           String      @default("PENDING") @db.VarChar(32)
  currentVersion   Int?        @map("current_version")
  approvedVersion  Int?        @map("approved_version")
  errorMessage     String?     @map("error_message") @db.Text
  incomingGuidance String?     @map("incoming_guidance") @db.Text
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflowRun      WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  versions         StepVersion[]

  @@unique([workflowRunId, stepType], map: "workflow_steps_workflow_run_id_step_type_key")
  @@map("workflow_steps")
}

model StepVersion {
  id               Int          @id @default(autoincrement())
  workflowStepId   Int          @map("workflow_step_id")
  parentVersionId  Int?         @map("parent_version_id")
  version          Int
  inputJson        Json?        @map("input_json")
  outputJson       Json         @map("output_json")
  humanFeedback    String?      @map("human_feedback") @db.Text
  validationStatus String       @default("valid") @map("validation_status") @db.VarChar(32)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  workflowStep     WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  parent           StepVersion? @relation("StepVersionTree", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children         StepVersion[] @relation("StepVersionTree")
  publications     ScriptPublication[]

  @@unique([workflowStepId, version], map: "step_versions_workflow_step_id_version_key")
  @@index([parentVersionId], map: "step_versions_parent_version_id_idx")
  @@map("step_versions")
}

model WorkflowEvent {
  id            Int         @id @default(autoincrement())
  workflowRunId Int         @map("workflow_run_id")
  type          String      @map("event_type") @db.VarChar(64)
  message       String      @db.Text
  metadataJson  Json?       @map("metadata_json")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId, id], map: "workflow_events_workflow_run_id_id_idx")
  @@map("workflow_events")
}

model ScriptPublication {
  id                       Int          @id @default(autoincrement())
  workflowRunId            Int          @map("workflow_run_id")
  approvedVersionId        Int          @unique @map("approved_version_id")
  approvedById             String       @map("approved_by_id") @db.VarChar(36)
  finalScript              String       @map("final_script") @db.Text
  wordCount                Int          @map("word_count")
  estimatedDurationSeconds Int          @map("estimated_duration_seconds")
  publishedAt              DateTime     @default(now()) @map("published_at") @db.Timestamptz(3)
  workflowRun              WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  approvedVersion          StepVersion  @relation(fields: [approvedVersionId], references: [id], onDelete: Cascade)
  approvedBy               User         @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  narrations               EpisodeNarration[]

  @@index([workflowRunId], map: "script_publications_workflow_run_id_idx")
  @@map("script_publications")
}
