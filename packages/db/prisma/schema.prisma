datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN

  @@map("content_status")
}

enum ReleaseScheduleStatus {
  SCHEDULED
  READY_TO_PUBLISH
  PUBLISHING
  RELEASED
  BLOCKED
  FAILED
  CANCELLED

  @@map("release_schedule_status")
}

enum EpisodeReviewStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED

  @@map("episode_review_status")
}

enum ReleaseReassignmentTicketStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("release_reassignment_ticket_status")
}

enum NarrationType {
  THIRD_PERSON
  FIRST_PERSON

  @@map("narration_type")
}

enum MediaKind {
  AUDIO
  IMAGE
  DOCUMENT

  @@map("media_kind")
}

enum MediaStatus {
  PENDING
  READY
  DELETED

  @@map("media_status")
}

enum HistoricalEntityType {
  FIGURE
  EVENT

  @@map("historical_entity_type")
}

enum EntityTagStatus {
  SUGGESTED
  CONFIRMED
  REJECTED

  @@map("entity_tag_status")
}

enum TagOrigin {
  AI
  MODERATOR

  @@map("tag_origin")
}

enum SourceTier {
  TIER_1_CHINH_SU
  TIER_2_KHAO_CO
  TIER_3_KHOA_HOC
  TIER_4_DA_SU

  @@map("source_tier")
}

enum MissionActivityType {
  COMPLETE_EPISODE
  PASS_QUIZ

  @@map("mission_activity_type")
}

enum XpSourceType {
  EPISODE_COMPLETION
  QUIZ_PASS
  WEEKLY_MISSION
  ADMIN_ADJUSTMENT

  @@map("xp_source_type")
}

model User {
  id            String    @id @db.VarChar(36)
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @db.VarChar(2048)
  role          String    @default("user") @db.VarChar(16)
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason") @db.Text
  banExpires    DateTime? @map("ban_expires_at") @db.Timestamptz(3)
  totalXp       Int       @default(0) @map("total_xp")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts                Account[]
  sessions                Session[]
  topics                  Topic[]                @relation("TopicCreator")
  historicalPeriods       HistoricalPeriod[]     @relation("HistoricalPeriodCreator")
  historicalEntities      HistoricalEntity[]     @relation("HistoricalEntityCreator")
  sources                 Source[]               @relation("SourceCreator")
  ownedSeries             Series[]               @relation("SeriesOwner")
  lockedSeries            Series[]               @relation("SeriesLocker")
  lockedEpisodes          Episode[]              @relation("EpisodeLocker")
  uploadedMediaAssets     MediaAsset[]           @relation("MediaUploader")
  confirmedEntityTags     EpisodeEntityTag[]     @relation("EntityTagConfirmer")
  quizAttempts            QuizAttempt[]
  listeningProgress       ListeningProgress[]
  missionTemplates        MissionTemplate[]      @relation("MissionTemplateCreator")
  activatedWeeklyMissions WeeklyMission[]        @relation("WeeklyMissionActivator")
  userWeeklyMissions      UserWeeklyMission[]
  xpAwards                XpAward[]
  idempotencyKeys         IdempotencyKey[]
  updatedSystemConfigs    SystemConfig[]         @relation("SystemConfigUpdater")
  auditLogs               AuditLog[]             @relation("AuditActor")
  releaseSchedules        ReleaseSchedule[]      @relation("ReleaseScheduleCreator")
  releaseAssignments      ProductionAssignment[] @relation("ReleaseAssignee")
  assignedReleaseWork     ProductionAssignment[] @relation("ReleaseAssigner")
  submittedEpisodeReviews EpisodeReview[]        @relation("EpisodeReviewSubmitter")
  reviewedEpisodes        EpisodeReview[]        @relation("EpisodeReviewer")
  releaseReminders        ReleaseReminder[]      @relation("ReleaseReminderRecipient")
  requestedReleaseReassignments ReleaseReassignmentTicket[] @relation("ReleaseReassignmentRequester")
  replacementReleaseReassignments ReleaseReassignmentTicket[] @relation("ReleaseReassignmentReplacement")
  resolvedReleaseReassignments ReleaseReassignmentTicket[] @relation("ReleaseReassignmentResolver")

  @@map("users")
}

model Session {
  id             String   @id @db.VarChar(36)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String   @unique @db.VarChar(500)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text
  userId         String   @map("user_id") @db.VarChar(36)
  impersonatedBy String?  @map("impersonated_by_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

model Account {
  id                    String    @id @db.VarChar(36)
  accountId             String    @map("account_id") @db.Text
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.VarChar(36)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "accounts_user_id_idx")
  @@map("accounts")
}

model Verification {
  id         String   @id @db.VarChar(36)
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}

model Topic {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  slug        String   @unique @db.VarChar(280)
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   User?    @relation("TopicCreator", fields: [createdById], references: [id], onDelete: SetNull)
  series      Series[]

  @@map("topics")
}

model HistoricalPeriod {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String               @unique @db.VarChar(255)
  slug        String               @unique @db.VarChar(280)
  startYear   Int?                 @map("start_year") @db.Integer
  endYear     Int?                 @map("end_year") @db.Integer
  sortOrder   Int                  @default(0) @map("sort_order") @db.SmallInt
  isActive    Boolean              @default(true) @map("is_active")
  createdById String?              @map("created_by_id") @db.VarChar(36)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   User?                @relation("HistoricalPeriodCreator", fields: [createdById], references: [id], onDelete: SetNull)
  phases      HistoricalPhase[]
  time        Json                 @default("{\"kind\":\"UNKNOWN\",\"note\":\"Chưa xác định thời gian\"}")
  version     Int                  @default(1)
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamptz(3)
  citations   HistoricalCitation[]
  summary     String?              @db.Text

  @@map("historical_periods")
}

/// Giai đoạn thuộc một Thời kỳ. Năm theo quy ước nửa kín [startYear, endYear): endYear loại trừ,
/// null = còn tiếp diễn (endYear) / không xác định (startYear). Năm TCN là số âm, không có năm 0.
model HistoricalPhase {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId    String               @map("period_id") @db.Uuid
  name        String               @db.VarChar(255)
  slug        String               @unique @db.VarChar(280)
  startYear   Int?                 @map("start_year") @db.Integer
  endYear     Int?                 @map("end_year") @db.Integer
  note        String?              @db.Text
  sortOrder   Int                  @default(0) @map("sort_order") @db.SmallInt
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  period      HistoricalPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  series      Series[]
  time        Json                 @default("{\"kind\":\"UNKNOWN\",\"note\":\"Chưa xác định thời gian\"}")
  version     Int                  @default(1)
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamptz(3)
  citations   HistoricalCitation[]
  summary     String?              @db.Text
  createdById String?              @map("created_by_id") @db.VarChar(36)
  entities    HistoricalEntity[]

  @@index([periodId, sortOrder], map: "historical_phases_period_id_sort_order_idx")
  @@map("historical_phases")
}

model HistoricalEntity {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType        HistoricalEntityType       @map("entity_type")
  name              String                     @db.VarChar(255)
  slug              String                     @unique @db.VarChar(280)
  aliases           String[]                   @default([])
  startYear         Int?                       @map("start_year") @db.Integer
  endYear           Int?                       @map("end_year") @db.Integer
  summary           String?                    @db.Text
  createdById       String?                    @map("created_by_id") @db.VarChar(36)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         User?                      @relation("HistoricalEntityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  narrations        EpisodeNarration[]
  episodeTags       EpisodeEntityTag[]
  time              Json                       @default("{\"kind\":\"UNKNOWN\",\"note\":\"Chưa xác định thời gian\"}")
  version           Int                        @default(1)
  deletedAt         DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  citations         HistoricalCitation[]
  historicalPhaseId String?                    @map("historical_phase_id") @db.Uuid
  historicalPhase   HistoricalPhase?           @relation(fields: [historicalPhaseId], references: [id], onDelete: Restrict)
  reviewStatus      HistoricalReviewStatus     @default(DRAFT) @map("review_status")
  reviewedVersion   Int?                       @map("reviewed_version")
  reviewedById      String?                    @map("reviewed_by_id") @db.VarChar(36)
  reviewedAt        DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?                    @map("review_note") @db.Text
  revisions         HistoricalEntityRevision[]
  primarySeries     Series[]                   @relation("PrimaryHistoricalEvent")

  @@index([entityType], map: "historical_entities_entity_type_idx")
  @@index([historicalPhaseId, reviewStatus, deletedAt])
  @@map("historical_entities")
}

model Source {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier                SourceTier
  title               String                   @db.VarChar(500)
  originalTitle       String?                  @map("original_title") @db.VarChar(500)
  author              String?                  @db.VarChar(255)
  translator          String?                  @db.VarChar(255)
  publisher           String?                  @db.VarChar(255)
  publicationYear     Int?                     @map("publication_year") @db.Integer
  edition             String?                  @db.VarChar(100)
  isbn                String?                  @db.VarChar(17)
  url                 String?                  @db.VarChar(2048)
  createdById         String?                  @map("created_by_id") @db.VarChar(36)
  archivedAt          DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy           User?                    @relation("SourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fileAssetId         String?                  @unique(map: "sources_file_asset_id_key") @map("file_asset_id") @db.Uuid
  fileAsset           MediaAsset?              @relation("SourceFile", fields: [fileAssetId], references: [id], onDelete: Restrict)
  seriesSources       SeriesSource[]
  version             Int                      @default(1)
  verificationStatus  SourceVerificationStatus @default(PENDING) @map("verification_status")
  verifiedVersion     Int?                     @map("verified_version")
  verifiedById        String?                  @map("verified_by_id") @db.VarChar(36)
  verifiedAt          DateTime?                @map("verified_at") @db.Timestamptz(3)
  verificationNote    String?                  @map("verification_note") @db.Text
  revisions           SourceRevision[]
  historicalCitations HistoricalCitation[]
  pages               SourcePage[]

  @@map("sources")
}

/// Per-page text of a source PDF for AI source checking. Full-text search uses the expression index
/// `source_pages_tsv_idx` (raw SQL in the migration; Prisma does not model it).
model SourcePage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  version   Int
  page      Int
  text      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, version, page], map: "source_pages_source_version_page_key")
  @@map("source_pages")
}

model Series {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                    String                    @map("owner_id") @db.VarChar(36)
  topicId                    String?                   @map("topic_id") @db.Uuid
  historicalPhaseId          String?                   @map("historical_phase_id") @db.Uuid
  title                      String                    @db.VarChar(255)
  slug                       String                    @unique @db.VarChar(280)
  description                String?                   @db.Text
  language                   String                    @default("vi") @db.VarChar(35)
  coverImageAssetId          String?                   @map("cover_image_asset_id") @db.Uuid
  coverLandscapeAssetId      String?                   @map("cover_landscape_asset_id") @db.Uuid
  startYear                  Int?                      @map("start_year") @db.Integer
  endYear                    Int?                      @map("end_year") @db.Integer
  status                     ContentStatus             @default(DRAFT)
  statusBeforeDelete         ContentStatus?            @map("status_before_delete")
  adminLockedAt              DateTime?                 @map("admin_locked_at") @db.Timestamptz(3)
  adminLockedById            String?                   @map("admin_locked_by_id") @db.VarChar(36)
  publishedAt                DateTime?                 @map("published_at") @db.Timestamptz(3)
  deletedAt                  DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                      User                      @relation("SeriesOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  topic                      Topic?                    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  historicalPhase            HistoricalPhase?          @relation(fields: [historicalPhaseId], references: [id], onDelete: Restrict)
  coverImageAsset            MediaAsset?               @relation("SeriesCover", fields: [coverImageAssetId], references: [id], onDelete: Restrict)
  coverLandscapeAsset        MediaAsset?               @relation("SeriesCoverLandscape", fields: [coverLandscapeAssetId], references: [id], onDelete: Restrict)
  adminLockedBy              User?                     @relation("SeriesLocker", fields: [adminLockedById], references: [id], onDelete: SetNull)
  episodes                   Episode[]
  sources                    SeriesSource[]
  primaryHistoricalEventId   String?                   @map("primary_historical_event_id") @db.Uuid
  primaryHistoricalEvent     HistoricalEntity?         @relation("PrimaryHistoricalEvent", fields: [primaryHistoricalEventId], references: [id], onDelete: Restrict)
  historicalEntityRevisionId String?                   @map("historical_entity_revision_id") @db.Uuid
  historicalEntityRevision   HistoricalEntityRevision? @relation(fields: [historicalEntityRevisionId], references: [id], onDelete: Restrict)
  publicationEvidence        Json?                     @map("publication_evidence")

  @@index([ownerId], map: "series_owner_id_idx")
  @@index([topicId], map: "series_topic_id_idx")
  @@index([historicalPhaseId], map: "series_historical_phase_id_idx")
  @@index([startYear, endYear], map: "series_year_range_idx")
  @@map("series")
}

model Episode {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seriesId           String              @map("series_id") @db.Uuid
  title              String              @db.VarChar(255)
  slug               String              @unique @db.VarChar(280)
  description        String?             @db.Text
  sortOrder          Int                 @map("sort_order")
  status             ContentStatus       @default(DRAFT)
  statusBeforeDelete ContentStatus?      @map("status_before_delete")
  adminLockedAt      DateTime?           @map("admin_locked_at") @db.Timestamptz(3)
  adminLockedById    String?             @map("admin_locked_by_id") @db.VarChar(36)
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  contentRevision    Int                 @default(1) @map("content_revision")
  series             Series              @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  adminLockedBy      User?               @relation("EpisodeLocker", fields: [adminLockedById], references: [id], onDelete: SetNull)
  narrations         EpisodeNarration[]
  attachments        EpisodeAttachment[]
  entityTags         EpisodeEntityTag[]
  quiz               Quiz?
  quizDraft          QuizWorkspaceDraft?
  listeningProgress  ListeningProgress[]
  releaseSchedules   ReleaseSchedule[]
  reviews            EpisodeReview[]
  aiChecks           AiCheck[]
  /// Canonical approval `{contentRevision, assessment, approvedById, approvedAt, exceptionReason}`; valid only while contentRevision matches.
  publicationApproval Json?         @map("publication_approval")

  @@index([seriesId, sortOrder], map: "episodes_series_id_sort_order_idx")
  @@map("episodes")
}

model ReleaseSchedule {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  episodeId          String?                @map("episode_id") @db.Uuid
  title              String                 @db.VarChar(255)
  productionDeadline DateTime               @map("production_deadline") @db.Timestamptz(3)
  scheduledAt        DateTime               @map("scheduled_at") @db.Timestamptz(3)
  status             ReleaseScheduleStatus  @default(SCHEDULED)
  version            Int                    @default(1)
  createdById        String                 @map("created_by_id") @db.VarChar(36)
  publishedAt        DateTime?              @map("published_at") @db.Timestamptz(3)
  cancelledAt        DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  failureCode        String?                @map("failure_code") @db.VarChar(64)
  failureMessage     String?                @map("failure_message") @db.Text
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  episode            Episode?               @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation("ReleaseScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments        ProductionAssignment[]
  reviews            EpisodeReview[]
  reminders          ReleaseReminder[]
  reassignmentTickets ReleaseReassignmentTicket[]

  @@index([status, scheduledAt], map: "release_schedules_status_scheduled_at_idx")
  @@index([episodeId, status], map: "release_schedules_episode_id_status_idx")
  @@map("release_schedules")
}

model ProductionAssignment {
  scheduleId   String          @map("schedule_id") @db.Uuid
  moderatorId  String          @map("moderator_id") @db.VarChar(36)
  assignedById String          @map("assigned_by_id") @db.VarChar(36)
  assignedAt   DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(3)
  removedAt    DateTime?       @map("removed_at") @db.Timestamptz(3)
  schedule     ReleaseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  moderator    User            @relation("ReleaseAssignee", fields: [moderatorId], references: [id], onDelete: Restrict)
  assignedBy   User            @relation("ReleaseAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([scheduleId, moderatorId, assignedAt])
  @@index([moderatorId, removedAt], map: "production_assignments_moderator_active_idx")
  @@map("production_assignments")
}

model ReleaseReassignmentTicket {
  id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId             String                            @map("schedule_id") @db.Uuid
  requestedById          String                            @map("requested_by_id") @db.VarChar(36)
  reason                 String                            @db.Text
  status                 ReleaseReassignmentTicketStatus   @default(PENDING)
  replacementModeratorId String?                           @map("replacement_moderator_id") @db.VarChar(36)
  resolvedById           String?                           @map("resolved_by_id") @db.VarChar(36)
  decisionReason         String?                           @map("decision_reason") @db.Text
  resolvedAt             DateTime?                         @map("resolved_at") @db.Timestamptz(3)
  cancelledAt            DateTime?                         @map("cancelled_at") @db.Timestamptz(3)
  createdAt              DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule               ReleaseSchedule                   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  requestedBy            User                              @relation("ReleaseReassignmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  replacementModerator   User?                             @relation("ReleaseReassignmentReplacement", fields: [replacementModeratorId], references: [id], onDelete: Restrict)
  resolvedBy             User?                             @relation("ReleaseReassignmentResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([requestedById, createdAt], map: "release_reassignment_tickets_requester_created_idx")
  @@index([status, createdAt], map: "release_reassignment_tickets_status_created_idx")
  @@map("release_reassignment_tickets")
}

model EpisodeReview {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId    String              @map("schedule_id") @db.Uuid
  episodeId     String              @map("episode_id") @db.Uuid
  revision      Int
  status        EpisodeReviewStatus @default(IN_REVIEW)
  submittedById String              @map("submitted_by_id") @db.VarChar(36)
  submittedAt   DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById  String?             @map("reviewed_by_id") @db.VarChar(36)
  reviewedAt    DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewNote    String?             @map("review_note") @db.Text
  readinessSnapshot Json?           @map("readiness_snapshot")
  schedule      ReleaseSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  episode       Episode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  submittedBy   User                @relation("EpisodeReviewSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
