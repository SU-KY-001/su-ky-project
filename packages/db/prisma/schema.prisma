}

model AiCheck {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.VarChar(36)
  episodeId       String        @map("episode_id") @db.Uuid
  kind            AiCheckKind
  status          AiCheckStatus
  config          Json
  totalBlocks     Int           @map("total_blocks")
  processedBlocks Int           @default(0) @map("processed_blocks")
  failedBlocks    Int           @default(0) @map("failed_blocks")
  toolCalls       Int           @default(0) @map("tool_calls")
  sourcesUsed     Json          @default("[]") @map("sources_used")
  inputTokens     Int           @default(0) @map("input_tokens")
  outputTokens    Int           @default(0) @map("output_tokens")
  model           String?       @db.VarChar(100)
  promptVersion   String?       @map("prompt_version") @db.VarChar(50)
  heartbeatAt     DateTime?     @map("heartbeat_at") @db.Timestamptz(3)
  errorCode       String?       @map("error_code") @db.VarChar(100)
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?     @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  episode         Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  items           AiCheckItem[]

  @@index([userId, createdAt], map: "ai_checks_user_id_created_at_idx")
  @@index([episodeId, createdAt], map: "ai_checks_episode_id_created_at_idx")
  @@index([userId, status], map: "ai_checks_user_id_status_idx")
  @@index([status, heartbeatAt], map: "ai_checks_status_heartbeat_at_idx")
  @@map("ai_checks")
}

model AiCheckItem {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkId       String          @map("check_id") @db.Uuid
  seq           Int
  blockRef      String          @map("block_ref") @db.VarChar(32)
  blockHash     String          @map("block_hash") @db.VarChar(16)
  blockPrevHash String          @map("block_prev_hash") @db.VarChar(16)
  blockDup      Int             @map("block_dup") @db.SmallInt
  kind          AiIssueKind
  severity      AiIssueSeverity
  basis         AiItemBasis
  evidence      Json            @default("[]")
  message       String          @db.Text
  suggestion    String?         @db.Text
  status        AiItemStatus    @default(OPEN)
  appliedAt     DateTime?       @map("applied_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  check         AiCheck         @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([checkId, seq], map: "ai_check_items_check_id_seq_key")
  @@index([checkId, status], map: "ai_check_items_check_id_status_idx")
  @@map("ai_check_items")
}

/// Moderator-owned narrative angles for AI drafting. Unique (user_id, lower(name)) is an expression index
/// (raw SQL in the migration; Prisma does not model it). Built-in angles live in api code, not here.
model AiNarrativeAngle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(60)
  description String   @db.VarChar(160)
  guide       String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "ai_narrative_angles_user_id_idx")
  @@map("ai_narrative_angles")
}
