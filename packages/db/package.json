{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env run prisma generate",
    "db:push": "bun --env-file=../../.env run prisma db push",
    "db:migrate": "bun --env-file=../../.env run prisma migrate dev",
    "db:seed": "bun --env-file=../../.env run src/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@repo/shared": "workspace:*"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
