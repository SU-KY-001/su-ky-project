{
  "name": "su-ky-monorepo",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.8.4",
    "zustand": "^5.0.3",
    "zod": "^3.24.2",
    "yup": "^1.6.1",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^5.0.1",
    "hono": "^4.7.2",
    "@prisma/client": "^6.4.1",
    "prisma": "^6.4.1",
    "typescript": "~6.0.3",
    "@types/node": "^22.20.2",
    "bun-types": "^1.4.2",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.13.0",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "postinstall": "bun run --cwd packages/db db:generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules dist apps/*/dist packages/*/dist",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:deploy": "turbo db:deploy",
    "db:seed": "turbo db:seed"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "turbo": "^2.4.4",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
