# Server Port
PORT=3005

# Database Connection (PostgreSQL) - host port must equal POSTGRES_PORT
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/suky_dev

# Docker Postgres (compose.yaml)
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=suky_dev

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Cloudinary media
CLOUDINARY_FOLDER=su-ky
CLOUDINARY_TIMEOUT_MS=10000
CLOUDINARY_DOCUMENT_DELIVERY_TTL_SECONDS=3600
SOURCE_PDF_TIMEOUT_MS=120000
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=


# Better Auth
BETTER_AUTH_URL=http://localhost:3005
# Generate a persistent secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend API URL
VITE_API_URL=http://localhost:3005

# Seed
ADMIN_EMAIL=admin@suky.vn
# Content seed (`bun run seed:content` in apps/api): signs in over HTTP as an EXISTING moderator/admin account.
# It never creates accounts. SEED_API_URL defaults to BETTER_AUTH_URL.
# SEED_SOURCE_URL_BASE is the base URL for sample source links (a source needs a url or a file).
# SEED_MOD_EMAIL=
# SEED_MOD_PASSWORD=
# SEED_SOURCE_URL_BASE=
# SEED_API_URL=

# Logging
LOG_LEVEL=info

# --- AI engine (Pi SDK), optional: initialised lazily, missing keys never block API startup ---
# google -> GEMINI_API_KEY ; opencode-go -> OPENCODE_API_KEY ; PI_API_KEY overrides both
PI_PROVIDER=google
PI_MODEL=gemini-3.5-flash-lite
PI_THINKING_LEVEL=low
# One key, or a comma-separated list. TTS switches keys only on HTTP 429;
# each distinct key is tried at most once per chunk within one request timeout.
# AI review/compose uses the first non-empty key unless PI_API_KEY overrides it.
GEMINI_API_KEY=
OPENCODE_API_KEY=
# PI_API_KEY=
# Optional: override the bundled pi-web-access extension directory
# PI_WEB_ACCESS_DIR=
# Pi's single retry layer: attempts, first backoff (doubles each time), per-request timeout
# PI_RETRY_MAX=2
# PI_RETRY_BASE_DELAY_MS=2000
# PI_PROVIDER_TIMEOUT_MS=60000
# PI_RUN_TIMEOUT_MS=300000

# AI script review (apps/api/src/modules/ai-assist). All optional; values shown are the defaults.
# Deadline for one whole check (ms), parallel batches inside a check, and per-user / global caps
# AI_ASSIST_TIMEOUT_MS=900000
# AI_ASSIST_BLOCK_CONCURRENCY=2
# AI_ASSIST_MAX_CONCURRENT_PER_USER=2
# AI_ASSIST_GLOBAL_MODEL_CONCURRENCY=4
# One agent session per batch of adjacent blocks; tool-call budget per session
# AI_ASSIST_BATCH_BLOCKS=8
# AI_ASSIST_BATCH_MAX_CHARS=4000
# AI_ASSIST_MAX_TOOL_CALLS=12
# A running check writes a heartbeat; the reaper closes checks silent for longer than STALE_AFTER
# AI_ASSIST_RUN_HEARTBEAT_MS=10000
# AI_ASSIST_STALE_AFTER_MS=60000
# SSE keep-alive (phase 3)
# AI_ASSIST_HEARTBEAT_MS=15000
# Narrative angles one moderator may create (built-in angles do not count)
# AI_ANGLE_MAX_PER_USER=50
# AI compose (outline / draft-section / rewrite): synchronous calls, nothing is stored
# Deadline of one call in ms (queue wait included), most variants per rewrite (1-10), series source excerpt budget (chars)
# AI_ASSIST_CALL_TIMEOUT_MS=90000
# AI_REWRITE_MAX_VARIANTS=10
# AI_ASSIST_MAX_SOURCE_CHARS=8000

# AI voice (Gemini TTS) for the "Giọng đọc" step. Uses GEMINI_API_KEY. One request per chunk of the script;
# Free-tier quota is project/model-scoped; keys in one project may share it. Needs ffmpeg. Jobs are in memory.
# TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS_DIALOGUE_MODEL=gemini-3.8-flash-tts
# TTS_STYLE=Podcast - Calm, measured delivery
# TTS_CHUNK_CHARS=3000
# TTS_CONCURRENCY=3
# TTS_REQUEST_TIMEOUT_MS=180000
# TTS_JOB_TTL_MS=1800000
# FFMPEG_PATH=ffmpeg
