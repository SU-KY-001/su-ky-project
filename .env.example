# Server Port
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suky_dev

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate a persistent secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend API URL
VITE_API_URL=http://localhost:3000

# --- AI script workflow (Pi SDK) ---
PI_PROVIDER=google
GEMINI_API_KEY=
PI_MODEL=gemini-2.5-flash
PI_THINKING_LEVEL=medium
# Optional: override the bundled pi-web-access extension directory
# PI_WEB_ACCESS_DIR=
