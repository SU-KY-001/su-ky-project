nhãn = cột FK; đầu cha: đúng một / không-hoặc-một nếu FK nullable; đầu con: nhiều / không-hoặc-một nếu unique. 30 FK tới users không vẽ dây." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="1588" width="1400" height="40" as="geometry"/></mxCell><mxCell id="title" value="00-overview · Tổng quan — toàn bộ 45 bảng của Su-Ky, tô màu theo domain; dây = khóa ngoại (không gồm FK tới users)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="-56" width="2444" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>